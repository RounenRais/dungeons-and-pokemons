# Public leaderboard backend
#
# Preferred: a PostgreSQL-compatible DATABASE_URL. Apply the idempotent schema:
#   psql "$DATABASE_URL" -f db/migrations/0001_leaderboard.sql
#
# UYARI: Supabase'in doğrudan adresi (`db.<ref>.supabase.co`) yalnızca IPv6
# (AAAA) kaydı yayınlıyor; Vercel serverless gibi IPv4-only ortamlar onu
# çözemiyor ve `getaddrinfo ENOTFOUND` veriyor. Supabase'te bunun yerine
# Transaction pooler adresini kullanın:
#   postgresql://postgres.<ref>:<ŞIFRE>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Ayrıntı: docs/leaderboard.md
DATABASE_URL=

# Alternative: Supabase server-side REST access. Use this pair only when a
# direct DATABASE_URL is not available. Never prefix the service key with
# NEXT_PUBLIC_; it must not enter the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key used to sign server-generated runId/seed tickets. Use a stable,
# random value of at least 16 characters in production.
LEADERBOARD_SECRET=

# With no database variables, development uses an explicitly labelled,
# process-local temporary leaderboard. Production disables public leaderboard
# storage; it never presents localStorage scores as a shared public board.
