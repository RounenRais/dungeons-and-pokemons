# Global skor tablosu (isteğe bağlı).
#
# Bu iki değişken TANIMLI DEĞİLSE oyun eksiksiz çalışmaya devam eder; skor
# tablosu o zaman sadece cihazın localStorage'ından okunur ve menüde "this
# device" diye görünür. Tanımlıysa bütün oyuncular aynı tabloda yarışır.
#
# Kurulum:
#   1. supabase.com'da ücretsiz bir proje aç.
#   2. Project Settings → API'den URL ve `service_role` anahtarını al.
#   3. Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldur.
#   4. SQL Editor'de aşağıdaki tabloyu bir kez oluştur.
#
# `service_role` anahtarı SADECE sunucuda okunur (app/api/leaderboard/route.ts).
# Adı NEXT_PUBLIC_ ile başlamıyor, yani tarayıcı paketine hiç girmiyor —
# başlatmayın, yoksa anahtar herkese açılır.
#
#   create table public.leaderboard (
#     id           text primary key,
#     name         text not null,
#     depth        integer not null,
#     best_level   integer not null,
#     bosses       integer not null,
#     finished_at  bigint  not null,
#     created_at   timestamptz not null default now()
#   );
#   create index leaderboard_rank_idx
#     on public.leaderboard (depth desc, best_level desc, bosses desc, finished_at asc);
#   alter table public.leaderboard enable row level security;
#
# RLS açık ve hiç policy yok: anon anahtarla kimse okuyup yazamaz, sadece
# service_role kullanan API route erişir. Doğrulama da orada yapılır.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
